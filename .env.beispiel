# Vorlage für die Datei .env (gleicher Ordner wie package.json).
# Kopieren nach ".env", Werte eintragen, Server neu starten.
# Die .env gehört NICHT in Sicherungen, die weitergegeben werden, und nicht ins Versionsarchiv.

# --- Microsoft 365 (Postfach, Kalender, Ablage) ---
# App-Registrierung im Entra-Admin-Center, Anleitung: docs/MICROSOFT-365.md
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# --- Claude (KI-Assistent für Automatisierungen) ---
# API-Schlüssel aus https://platform.claude.com (Organisation des Vereins, Ausgabenlimit setzen!)
ANTHROPIC_API_KEY=
# Optional, Standard: claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# --- Jugendplaner (Spielbetrieb der Jugend, PHP-App auf dem Webspace) ---
# Anleitung: docs/JUGENDPLANER.md. SECRET = APP_SECRET aus der config.php des Jugendplaners.
# JUGENDPLANER_URL=https://wp.ttvbuehlertal.de/jugendplaner
# JUGENDPLANER_SECRET=
# Alternativ (ohne automatische Anmeldung): eine PIN des Jugendplaners
# JUGENDPLANER_PIN=

# --- Server ---
# PORT=3000
# HOST=127.0.0.1
# SECURE_COOKIES=1
