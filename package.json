{
  "name": "tt-ehrenamt",
  "version": "1.0.0",
  "description": "Web App für das Tischtennis-Ehrenamt: Aufgaben, Vorgänge, Jahreskalender, Automatisierungen mit Freigabe, Ablage, Auskunft und Protokoll.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "passwort-zuruecksetzen": "node --disable-warning=ExperimentalWarning scripts/reset-password.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
